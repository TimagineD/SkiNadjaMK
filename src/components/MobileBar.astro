    <span>📞</span> <span data-i18n="mob_call">{t.mob_call}</span>
  </a>
  <a href="https://wa.me/38978667738" target="_blank" rel="noopener" id="mob-wa">
    <span>💬</span> <span>WhatsApp</span>
