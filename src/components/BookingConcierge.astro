---
// BookingConcierge.astro - Identical Interactive Booking Concierge
import { t } from "../data/i18n";
---

<section class="booking-section" id="contact">
  <div class="booking-container">
    <div class="booking-box">
      <!-- Left Column: Fast Contacts & Info -->
      <div class="booking-info">
        <h2 data-i18n="book_box_title">{t.book_box_title}</h2>
        <p data-i18n="book_box_desc">{t.book_box_desc}</p>

        <div class="direct-contacts">
          <a
            href="tel:+38978667738"
            class="contact-action-btn btn-phone"
            id="call-main"
          >
            <span>
              📞 <span data-i18n="btn_direct_call">{t.btn_direct_call}</span>
            </span>
            <!-- <strong>+389 78 667 738</strong> -->
          </a>

          <a
            href="https://wa.me/38978667738"
            target="_blank"
            rel="noopener"
            class="contact-action-btn btn-wa"
            id="wa-main"
          >
            <span>
              💬 <span data-i18n="btn_direct_wa">{t.btn_direct_wa}</span>
            </span>
            <!-- <strong>WhatsApp Chat →</strong> -->
          </a>

          <a
            href="viber://chat?number=%2B38978667738"
            class="contact-action-btn btn-viber"
            id="viber-main"
          >
            <span>
              🟣 <span data-i18n="btn_direct_viber">{t.btn_direct_viber}</span>
            </span>
            <!-- <strong>Viber Chat →</strong> -->
          </a>
        </div>

        <!--         <div class="location-card-mini">
          <strong data-i18n="loc_mini_t">{t.loc_mini_t}</strong>
          <span data-i18n="loc_mini_d">{t.loc_mini_d}</span>
        </div> -->
      </div>

      <!-- Right Column: Interactive WhatsApp Inquiry Form -->
      <form class="booking-form" id="inquiryForm">
        <div class="form-group">
          <label for="userName" data-i18n="form_name">
            {t.form_name}
          </label>
          <input
            type="text"
            id="userName"
            name="name"
            class="form-control"
            placeholder="Внесете Име Презиме"
            required
            autocomplete="name"
          />
        </div>

        <div class="form-group">
          <label data-i18n="form_category">{t.form_category}</label>
          <div class="category-pills">
            <label class="category-pill-label">
              <input type="radio" name="topic" value="Ski equipment" checked />
              <span class="pill-content">
                <span>🎿</span> <span data-i18n="opt_ski">{t.opt_ski}</span>
              </span>
            </label>
            <label class="category-pill-label">
              <input type="radio" name="topic" value="Snowboard equipment" />
              <span class="pill-content">
                <span>🏂</span> <span data-i18n="opt_board">{t.opt_board}</span>
              </span>
            </label>
            <label class="category-pill-label">
              <input type="radio" name="topic" value="Sledges and kids' gear" />
              <span class="pill-content">
                <span>🛷</span> <span data-i18n="opt_kids">{t.opt_kids}</span>
              </span>
            </label>
            <label class="category-pill-label">
              <input type="radio" name="topic" value="Instructor / Lessons" />
              <span class="pill-content">
                <span>🧑‍🏫</span> <span data-i18n="opt_villa">{t.opt_villa}</span>
              </span>
            </label>
          </div>
        </div>

        <!-- Date & People Counter -->
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px;">
          <div class="form-group">
            <label for="bookDate" data-i18n="form_date">
              {t.form_date}
            </label>
            <input type="date" id="bookDate" class="form-control" />
          </div>

          <div class="form-group">
            <label data-i18n="form_people">{t.form_people}</label>
            <div class="counter-group">
              <button type="button" class="counter-btn" id="btnMinus">
                -
              </button>
              <span class="counter-value" id="peopleCount">
                2
              </span>
              <button type="button" class="counter-btn" id="btnPlus">
                +
              </button>
            </div>
          </div>
        </div>

        <div class="form-group">
          <label for="userMsg" data-i18n="form_details">
            {t.form_details}
          </label>
          <textarea
            id="userMsg"
            class="form-control"
            rows="3"
            placeholder="пр. Број на чевли 42 и 38, висина 180cm, за 2 дена"
          ></textarea>
        </div>

        <!-- Live Message Preview -->
        <div class="preview-box">
          <strong data-i18n="msg_preview_title">{t.msg_preview_title}</strong>
          <div class="preview-text" id="liveMsgPreview">
            ...
          </div>
        </div>

        <button type="submit" class="btn-submit-booking">
          <svg width="20" height="20" fill="currentColor" viewBox="0 0 24 24">
            <path d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2" />
          </svg>
          <span data-i18n="form_submit_btn">{t.form_submit_btn}</span>
        </button>
      </form>
    </div>
  </div>
</section>

<script>
  let count = 2;
  const peopleCountEl = document.getElementById("peopleCount") as HTMLElement;
  const nameInput = document.getElementById("userName") as HTMLInputElement;
  const msgInput = document.getElementById("userMsg") as HTMLTextAreaElement;
  const previewEl = document.getElementById("liveMsgPreview") as HTMLElement;
  const bookDateInput = document.getElementById("bookDate") as HTMLInputElement;

  const today = new Date().toISOString().split("T")[0];
  if (bookDateInput) {
    bookDateInput.value = today;
    bookDateInput.min = today;
  }

  document.getElementById("btnMinus")?.addEventListener("click", () => {
    if (count > 1) {
      count--;
      peopleCountEl.textContent = String(count);
      updateLivePreview();
    }
  });
  document.getElementById("btnPlus")?.addEventListener("click", () => {
    if (count < 25) {
      count++;
      peopleCountEl.textContent = String(count);
      updateLivePreview();
    }
  });

  document.querySelectorAll(".select-gear-btn").forEach((btn) => {
    btn.addEventListener("click", () => {
      const gear = btn.getAttribute("data-gear");
      if (gear) {
        const radio = document.querySelector(
          `input[name="topic"][value="${gear}"]`,
        ) as HTMLInputElement;
        if (radio) radio.checked = true;
        updateLivePreview();
      }
    });
  });

  function getSelectedTopic() {
    const checked = document.querySelector(
      'input[name="topic"]:checked',
    ) as HTMLInputElement;
    return checked ? checked.value : "Ski equipment";
  }

  function composeWhatsAppMessage() {
    const currentLang = document.documentElement.lang === "en" ? "en" : "mk";
    const name =
      nameInput?.value.trim() ||
      (currentLang === "mk" ? "[Вашето Име]" : "[Your Name]");
    const topic = getSelectedTopic();
    const date = bookDateInput?.value || today;
    const people = count;
    const details = msgInput?.value.trim() || "";

    if (currentLang === "mk") {
      let topicText = topic;
      if (topic === "Ski equipment") topicText = "Ски опрема";
      else if (topic === "Snowboard equipment") topicText = "Сноуборд опрема";
      else if (topic === "Sledges and kids' gear")
        topicText = "Санки и детска опрема";
      else if (topic === "Instructor / Lessons")
        topicText = "Инструктор / Часови";

      return (
        `Здраво Ски Надја, јас сум ${name}.\nЗаинтересиран/а сум за: ${topicText}.\n• Датум: ${date}\n• Број на лица: ${people}` +
        (details ? `\n• Големини/Забелешка: ${details}` : "")
      );
    } else {
      return (
        `Hello Ski Nadja, I'm ${name}.\nI'm interested in: ${topic}.\n• Date: ${date}\n• Number of people: ${people}` +
        (details ? `\n• Sizing/Notes: ${details}` : "")
      );
    }
  }

  function updateLivePreview() {
    if (previewEl) {
      previewEl.textContent = composeWhatsAppMessage();
    }
  }

  nameInput?.addEventListener("input", updateLivePreview);
  msgInput?.addEventListener("input", updateLivePreview);
  bookDateInput?.addEventListener("change", updateLivePreview);
  document
    .querySelectorAll('input[name="topic"]')
    .forEach((r) => r.addEventListener("change", updateLivePreview));
  updateLivePreview();

  document
    .getElementById("inquiryForm")
    ?.addEventListener("submit", function (e) {
      e.preventDefault();
      const PHONE = "38978667738";
      const text = composeWhatsAppMessage();
      window.open(
        "https://wa.me/" + PHONE + "?text=" + encodeURIComponent(text),
        "_blank",
        "noopener",
      );
    });

  (window as any).updateBookingPreview = updateLivePreview;
</script>
