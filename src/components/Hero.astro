---
// Hero.astro - Identical Alpine Hero Section
import { t } from "../data/i18n";

const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---
<section class="hero-section">
  <!-- Decorative Backdrop Artwork & Ambient Radial Sunrise Glow -->
  <div class="hero-backdrop"></div>
  <div class="hero-glow"></div>
  <div class="hero-container">

    <!-- Prominent Centered Emblem Logo below header/navigation bar (40% larger) -->
    <div class="hero-logo-badge">
      <img
        src={`${base}LOGO.svg`}
        alt="Ски Надја Пониква"
        class="hero-emblem-logo"
        width="112"
        height="118"
        loading="eager"
        decoding="async"
      />
    </div>

    <!-- Location Value Badge -->
    <div class="hero-pill">
      <span>🏔️</span>
      <span data-i18n="hero_pill">{t.hero_pill}</span>
    </div>

    <!-- Main Fluid Heading -->
    <h2 class="hero-title">
      <span data-i18n="hero_title_1">{t.hero_title_1}</span><br>
      <span class="gradient-text" data-i18n="hero_title_2">{t.hero_title_2}</span>
    </h2>

    <!-- Descriptive Subtitle -->
    <p class="hero-subtitle" data-i18n="hero_desc">
      {t.hero_desc}
    </p>

    <!-- Primary & Secondary Conversion CTA Buttons -->
    <div class="hero-cta-group">
      <a href="#contact" class="btn-primary">
        <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24">
          <path d="M5 12h14M12 5l7 7-7 7" />
        </svg>
        <span data-i18n="hero_cta_book">{t.hero_cta_book}</span>
      </a>
      <a href="#equipment" class="btn-secondary">
        <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path d="m6 9 6 6 6-6" />
        </svg>
        <span data-i18n="hero_cta_explore">{t.hero_cta_explore}</span>
      </a>
    </div>

    <!-- Four Key Service Highlight Cards: Trackside location, fast 5-min fitting, heated boot dryers, and all ages -->
    <div class="hero-highlights">
      <div class="highlight-card">
        <div class="highlight-icon">📍</div>
        <div class="highlight-info">
          <h4 data-i18n="hl1_t">{t.hl1_t}</h4>
          <p data-i18n="hl1_d">{t.hl1_d}</p>
        </div>
      </div>
      <div class="highlight-card">
        <div class="highlight-icon">⚡</div>
        <div class="highlight-info">
          <h4 data-i18n="hl2_t">{t.hl2_t}</h4>
          <p data-i18n="hl2_d">{t.hl2_d}</p>
        </div>
      </div>
      <div class="highlight-card">
        <div class="highlight-icon">🔥</div>
        <div class="highlight-info">
          <h4 data-i18n="hl3_t">{t.hl3_t}</h4>
          <p data-i18n="hl3_d">{t.hl3_d}</p>
        </div>
      </div>
      <div class="highlight-card">
        <div class="highlight-icon">👨‍👩‍👧‍👦</div>
        <div class="highlight-info">
          <h4 data-i18n="hl4_t">{t.hl4_t}</h4>
          <p data-i18n="hl4_d">{t.hl4_d}</p>
        </div>
      </div>
    </div>

  </div>
</section>
