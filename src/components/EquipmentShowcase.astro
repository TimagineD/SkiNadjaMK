---
// EquipmentShowcase.astro - Identical Gear Stream Rows
import { t } from "../data/i18n";

const base = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const bgMountain = `${base}позадина.webp`;
---

<div class="slope-stream" id="equipment">
  <!-- Section Background with lowest z-index -->
  <div
    class="equipment-backdrop"
    aria-hidden="true"
    style={`background-image: url('${bgMountain}');`}
  >
  </div>
  <div class="stream-container">
    <div class="section-header-badge">
      <span class="section-eyebrow" data-i18n="sec_eyebrow">{t.sec_eyebrow}</span>
      <h2 class="section-main-title" data-i18n="sec_main_title">{t.sec_main_title}</h2>
    </div>

    <!-- 1. SKI EQUIPMENT SHOWCASE ROW: Professional carving & all-mountain ski sets -->
    <div class="gear-showcase-row">
      <div class="gear-visual">
        <div class="image-stage-backdrop"></div>
        <div class="gear-image-wrapper">
          <picture>
            <source
              srcset={`${base}images/section1-skier.webp`}
              type="image/webp"
            />
            <img
              src={`${base}images/section1-skier.png`}
              alt="Скијач на Пониква - Ски Надја"
              width="1107"
              height="749"
              loading="lazy"
            />
          </picture>
        </div>
        <!-- Floating Spec Badges -->
        <div class="floating-card-badge badge-top-left">
          <span>⛷️</span>
          <span data-i18n="ski_badge_1">{t.ski_badge_1}</span>
        </div>
        <div class="floating-card-badge badge-bottom-right">
          <span>🛡️</span>
          <span data-i18n="ski_badge_2">{t.ski_badge_2}</span>
        </div>
      </div>

      <div class="gear-content">
        <div class="gear-tag" data-i18n="ski_tag">{t.ski_tag}</div>
        <h3 class="gear-title" data-i18n="ski_title">{t.ski_title}</h3>
        <p class="gear-desc" data-i18n="ski_desc">{t.ski_desc}</p>
        
        <!--
        <div class="spec-pills">
          <span class="spec-pill"
            ><span>🎿</span>
            <span data-i18n="ski_spec_1">{t.ski_spec_1}</span></span
          >
          <span class="spec-pill"
            ><span>👢</span>
            <span data-i18n="ski_spec_2">{t.ski_spec_2}</span></span
          >
          <span class="spec-pill"
            ><span>🪖</span>
            <span data-i18n="ski_spec_3">{t.ski_spec_3}</span></span
          >
          <span class="spec-pill"
            ><span>✨</span>
            <span data-i18n="ski_spec_4">{t.ski_spec_4}</span></span
          >
        </div>
        -->
        
        <div class="btn-wrap">
          <a
            href="#contact"
            class="btn-primary select-gear-btn"
            data-gear="Ski equipment"
          >
            <span data-i18n="btn_rent_ski">{t.btn_rent_ski}</span>
          </a>
          <a href="tel:+38978667738" class="btn-secondary">
            <svg
              width="16"
              height="16"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              viewBox="0 0 24 24"
            >
              <path
                d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"
              ></path>
            </svg>
            <span data-i18n="btn_call_us">{t.btn_call_us}</span>
          </a>
        </div>
      </div>
    </div>

    <!-- 2. SNOWBOARD EQUIPMENT SHOWCASE ROW: Freeride/All-Mountain snowboards and soft boots (Reversed Layout) -->
    <div class="gear-showcase-row reversed">
      <div class="gear-visual">
        <div class="image-stage-backdrop"></div>
        <div class="gear-image-wrapper">
          <picture>
            <source
              srcset={`${base}images/section2-snowboarder.webp`}
              type="image/webp"
            />
            <img
              src={`${base}images/section2-snowboarder.png`}
              alt="Сноубордер на Пониква - Ски Надја"
              width="1247"
              height="919"
              loading="lazy"
            />
          </picture>
        </div>
        <!-- Floating Badges -->
        <div class="floating-card-badge badge-top-left">
          <span>🏂</span>
          <span data-i18n="board_badge_1">{t.board_badge_1}</span>
        </div>
        <div class="floating-card-badge badge-bottom-right">
          <span>❄️</span>
          <span data-i18n="board_badge_2">{t.board_badge_2}</span>
        </div>
      </div>

      <div class="gear-content">
        <div class="gear-tag" data-i18n="board_tag">{t.board_tag}</div>
        <h3 class="gear-title" data-i18n="board_title">{t.board_title}</h3>
        <p class="gear-desc" data-i18n="board_desc">{t.board_desc}</p>
        <!--
        <div class="spec-pills">
          <span class="spec-pill"
            ><span>🏂</span>
            <span data-i18n="board_spec_1">{t.board_spec_1}</span></span
          >
          <span class="spec-pill"
            ><span>🥾</span>
            <span data-i18n="board_spec_2">{t.board_spec_2}</span></span
          >
          <span class="spec-pill"
            ><span>🔄</span>
            <span data-i18n="board_spec_3">{t.board_spec_3}</span></span
          >
          <span class="spec-pill"
            ><span>🧤</span>
            <span data-i18n="board_spec_4">{t.board_spec_4}</span></span
          >
        </div>
        -->
        <div class="btn-wrap">
          <a
            href="#contact"
            class="btn-primary select-gear-btn"
            data-gear="Snowboard equipment"
          >
            <span data-i18n="btn_rent_board">{t.btn_rent_board}</span>
          </a>
          <a
            href="https://wa.me/38978667738"
            target="_blank"
            rel="noopener"
            class="btn-secondary"
          >
            <svg width="16" height="16" fill="currentColor" viewBox="0 0 24 24">
              <path
                d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2"
              ></path>
            </svg>
            <span>WhatsApp</span>
          </a>
        </div>
      </div>
    </div>

    <!-- 3. KIDS & FAMILY SLEDGES SHOWCASE ROW: Sledges, kids' skis, warm winter suits (Centered Layout) -->
    <div class="gear-showcase-row centered-layout">
      <div class="gear-content">
        <div class="gear-tag" data-i18n="kids_tag">{t.kids_tag}</div>
        <h3 class="gear-title" data-i18n="kids_title">{t.kids_title}</h3>
        <p class="gear-desc" data-i18n="kids_desc">{t.kids_desc}</p>
        <!--
        <div class="spec-pills">
          <span class="spec-pill"
            ><span>🛷</span>
            <span data-i18n="kids_spec_1">{t.kids_spec_1}</span></span
          >
          <span class="spec-pill"
            ><span>🎿</span>
            <span data-i18n="kids_spec_2">{t.kids_spec_2}</span></span
          >
          <span class="spec-pill"
            ><span>🧥</span>
            <span data-i18n="kids_spec_3">{t.kids_spec_3}</span></span
          >
          <span class="spec-pill"
            ><span>⛑️</span>
            <span data-i18n="kids_spec_4">{t.kids_spec_4}</span></span
          >
        </div>
        -->
        <div class="btn-wrap">
          <a
            href="#contact"
            class="btn-primary select-gear-btn"
            data-gear="Sledges and kids' gear"
          >
            <span data-i18n="btn_rent_kids">{t.btn_rent_kids}</span>
          </a>
        </div>
      </div>

      <div class="gear-visual">
        <div class="image-stage-backdrop"></div>
        <div class="gear-image-wrapper">
          <picture>
            <source
              srcset={`${base}images/section3-kids.webp`}
              type="image/webp"
            />
            <img
              src={`${base}images/section3-kids.png`}
              alt="Детски санки и опрема на Пониква - Ски Надја"
              width="1408"
              height="785"
              loading="lazy"
            />
          </picture>
        </div>
      </div>
    </div>
  </div>
</div>
