---
// Footer.astro - Identical Alpine Footer
import { t } from "../data/i18n";

const base = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
---

<footer class="site-footer">
  <div class="footer-container">
    <div class="footer-main-grid">
      <div class="footer-brand">
        <a
          href="#"
          class="brand footer-brand-link"
          style="margin-bottom: 1rem;"
          aria-label="Ски Надја Пониква"
        >
          <img
            src={`${base}LOGO.svg`}
            alt="Ски Надја Пониква Лого"
            class="brand-logo footer-logo"
            width="44"
            height="46"
            loading="lazy"
            decoding="async"
          />
          <div class="brand-text">
            <h1 style="color: #ffffff; font-size: 1.15rem;">СКИ НАДЈА</h1>
            <span style="font-size: 0.65rem;">ПОНИКВА</span>
          </div>
        </a>
        <p data-i18n="footer_brand_desc">{t.footer_brand_desc}</p>
      </div>

      <div class="footer-col">
        <h4 data-i18n="foot_col_gear">{t.foot_col_gear}</h4>
        <ul class="footer-links">
          <li>
            <a href="#equipment" data-i18n="foot_l1">
              {t.foot_l1}
            </a>
          </li>
          <li>
            <a href="#equipment" data-i18n="foot_l2">
              {t.foot_l2}
            </a>
          </li>
          <li>
            <a href="#equipment" data-i18n="foot_l3">
              {t.foot_l3}
            </a>
          </li>
          <!-- <li><a href="#pricing" data-i18n="foot_l4">{t.foot_l4}</a></li> -->
        </ul>
      </div>

      <div class="footer-col">
        <h4 data-i18n="foot_col_services">{t.foot_col_services}</h4>
        <ul class="footer-links">
          <li>
            <a href="#villa" data-i18n="foot_l5">
              {t.foot_l5}
            </a>
          </li>
          <!-- <li><a href="#advantages" data-i18n="foot_l6">{t.foot_l6}</a></li> -->
          <li>
            <a href="#location" data-i18n="foot_l7">
              {t.foot_l7}
            </a>
          </li>
          <li>
            <a href="#contact" data-i18n="foot_l8">
              {t.foot_l8}
            </a>
          </li>
        </ul>
      </div>

      <div class="footer-col">
        <h4 data-i18n="foot_col_contact">{t.foot_col_contact}</h4>
        <ul class="footer-links">
          <li>
            <a href="tel:+38978667738" id="foot-phone">
              📞 +389 78 667 738
            </a>
          </li>
          <li>
            <a
              href="https://wa.me/38978667738"
              target="_blank"
              rel="noopener"
              id="foot-wa"
            >
              💬 WhatsApp Chat
            </a>
          </li>
          <li>
            <a href="viber://chat?number=%2B38978667738" id="foot-viber">
              🟣 Viber Chat
            </a>
          </li>
        </ul>
      </div>
    </div>

    <div class="footer-bottom">
      <p>
        © Ски Надја Пониква. <span id="currentYear"></span>{" "}
        <!-- Сите права се
        задржани. -->
      </p>
      <p data-i18n="footer_signature">{t.footer_signature}</p>
    </div>
  </div>
</footer>

<script>
  const yearEl = document.getElementById("currentYear");
  if (yearEl) yearEl.textContent = String(new Date().getFullYear());
</script>
