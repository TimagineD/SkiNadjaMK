---
// LocationFaq.astro - Identical Location Guide & FAQ Accordion
import { t } from "../data/i18n";
---
<section class="location-section" id="location">
  <div class="location-container">

    <!-- Location Information -->
    <div class="location-info">
      <span class="section-eyebrow" data-i18n="loc_eyebrow">{t.loc_eyebrow}</span>
      <h2 data-i18n="loc_title">{t.loc_title}</h2>
      <p data-i18n="loc_desc">
        {t.loc_desc}
      </p>

      <div class="location-meta-list">
        <div class="location-meta-item">
          <div class="meta-icon">📍</div>
          <div class="meta-content">
            <h4 data-i18n="loc_meta_address_t">{t.loc_meta_address_t}</h4>
            <p data-i18n="loc_meta_address_d">{t.loc_meta_address_d}</p>
          </div>
        </div>

        <div class="location-meta-item">
          <div class="meta-icon">⏰</div>
          <div class="meta-content">
            <h4 data-i18n="loc_meta_hours_t">{t.loc_meta_hours_t}</h4>
            <p data-i18n="loc_meta_hours_d">{t.loc_meta_hours_d}</p>
          </div>
        </div>

        <div class="location-meta-item">
          <div class="meta-icon">🚗</div>
          <div class="meta-content">
            <h4 data-i18n="loc_meta_road_t">{t.loc_meta_road_t}</h4>
            <p data-i18n="loc_meta_road_d">{t.loc_meta_road_d}</p>
          </div>
        </div>
      </div>

      <a href="https://maps.app.goo.gl/Au9CZVBoWoRqacr96" target="_blank" rel="noopener" class="btn-secondary">
        <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path
            d="M12 2a8 8 0 0 0-8 8c0 5.25 8 12 8 12s8-6.75 8-12a8 8 0 0 0-8-8zm0 11a3 3 0 1 1 0-6 3 3 0 0 1 0 6z" />
        </svg>
        <span data-i18n="btn_maps">{t.btn_maps}</span>
      </a>
    </div>

    <!-- FAQ Accordion -->
    <div class="faq-card">
      <span class="section-eyebrow" data-i18n="faq_eyebrow">{t.faq_eyebrow}</span>
      <h2 style="font-size: 1.8rem; margin-bottom: 1.5rem;" data-i18n="faq_title">{t.faq_title}</h2>

      <div class="faq-list">
        <div class="faq-item open">
          <div class="faq-question" data-i18n="faq_q1">{t.faq_q1}</div>
          <div class="faq-answer" data-i18n="faq_a1">{t.faq_a1}</div>
        </div>

        <div class="faq-item">
          <div class="faq-question" data-i18n="faq_q2">{t.faq_q2}</div>
          <div class="faq-answer" data-i18n="faq_a2">{t.faq_a2}</div>
        </div>

        <div class="faq-item">
          <div class="faq-question" data-i18n="faq_q3">{t.faq_q3}</div>
          <div class="faq-answer" data-i18n="faq_a3">{t.faq_a3}</div>
        </div>

        <div class="faq-item">
          <div class="faq-question" data-i18n="faq_q4">{t.faq_q4}</div>
          <div class="faq-answer" data-i18n="faq_a4">{t.faq_a4}</div>
        </div>
      </div>
    </div>

  </div>
</section>

<script>
  document.querySelectorAll(".faq-question").forEach(q => {
    q.addEventListener("click", () => {
      const item = q.parentElement;
      item?.classList.toggle("open");
    });
  });
</script>
